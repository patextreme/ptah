+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { fileURLToPath, pathToFileURL } from 'node:url'
+import type { McpServer, McpServerStdio } from '@agentclientprotocol/sdk'
+import {
+  filterStdioMcpServers,
+  toAdapterMcpConfigFile,
+  toNativeMcpConfigFile,
+  writeMcpConfigFile,
+  writeMcpRegisterExtension,
+  removeMcpConfigFile,
+  readMcpConfigFile,
+  mcpConfigFileMode,
+  prepareSessionMcpConfig,
+  detectMcpSupport,
+  resetMcpConfigSupportCacheForTests
+} from '../../src/acp/mcp-config.js'
+
+const FAKE_PI = fileURLToPath(new URL('../helpers/fake-pi.mjs', import.meta.url))
+
+type FakeMode = 'adapter' | 'native' | 'none'
+
+function stdioServer(overrides: Partial<McpServerStdio> = {}): McpServerStdio {
+  // Note: no `type` field — the TS SDK strips it for the untagged stdio variant.
+  return {
+    name: 'ptah',
+    command: '/usr/bin/ptah',
+    args: ['__bridge'],
+    env: [{ name: 'PTAH_BRIDGE_ADDR', value: '/tmp/sock' }],
+    ...overrides
+  }
+}
+
+function httpServer(): McpServer {
+  return { type: 'http', name: 'remote', url: 'https://mcp.example.com', headers: [] } as McpServer
+}
+
+/** Set up a fake pi invocation recorder: argv and selected child env. */
+function recorder(): {
+  dir: string
+  argsFile: string
+  envFile: string
+  lines(): string[][]
+  envLines(): Array<{ argv: string[]; PI_ACP_MCP_CONFIG: string | null }>
+} {
+  const dir = mkdtempSync(join(tmpdir(), 'pi-acp-mcp-test-'))
+  const argsFile = join(dir, 'args.jsonl')
+  const envFile = join(dir, 'env.jsonl')
+  writeFileSync(argsFile, '', 'utf-8')
+  writeFileSync(envFile, '', 'utf-8')
+  return {
+    dir,
+    argsFile,
+    envFile,
+    lines(): string[][] {
+      if (!existsSync(argsFile)) return []
+      return readFileSync(argsFile, 'utf-8')
+        .split('\n')
+        .filter(Boolean)
+        .map(l => JSON.parse(l) as string[])
+    },
+    envLines() {
+      if (!existsSync(envFile)) return []
+      return readFileSync(envFile, 'utf-8')
+        .split('\n')
+        .filter(Boolean)
+        .map(l => JSON.parse(l))
+    }
+  }
+}
+
+function withFakePi(mode: FakeMode, fn: (rec: ReturnType<typeof recorder>) => Promise<void> | void): Promise<void> {
+  const rec = recorder()
+  const prev = { ...process.env }
+  process.env.PI_ACP_PI_COMMAND = FAKE_PI
+  process.env.FAKE_PI_ARGS_FILE = rec.argsFile
+  process.env.FAKE_PI_ENV_FILE = rec.envFile
+  if (mode === 'adapter') {
+    delete process.env.FAKE_PI_HELP_HAS_MCP_CONFIG
+    delete process.env.FAKE_PI_HELP_HAS_NATIVE_MCP
+  } else if (mode === 'native') {
+    process.env.FAKE_PI_HELP_HAS_MCP_CONFIG = '0'
+    process.env.FAKE_PI_HELP_HAS_NATIVE_MCP = '1'
+  } else {
+    process.env.FAKE_PI_HELP_HAS_MCP_CONFIG = '0'
+    delete process.env.FAKE_PI_HELP_HAS_NATIVE_MCP
+  }
+  resetMcpConfigSupportCacheForTests()
+
+  return Promise.resolve()
+    .then(() => fn(rec))
+    .finally(() => {
+      for (const key of Object.keys(process.env)) {
+        if (!(key in prev)) delete process.env[key]
+      }
+      Object.assign(process.env, prev)
+      resetMcpConfigSupportCacheForTests()
+      rmSync(rec.dir, { recursive: true, force: true })
+    })
+}
+
+test('toAdapterMcpConfigFile maps ACP stdio servers to direct-tool pi-mcp-adapter entries', () => {
+  const config = toAdapterMcpConfigFile([
+    stdioServer(),
+    stdioServer({
+      name: 'other',
+      command: 'npx',
+      args: ['a', 'b'],
+      env: [
+        { name: 'K', value: 'V' },
+        { name: 'J', value: 'W' }
+      ]
+    })
+  ])
+
+  assert.deepEqual(config, {
+    mcpServers: {
+      ptah: { command: '/usr/bin/ptah', args: ['__bridge'], env: { PTAH_BRIDGE_ADDR: '/tmp/sock' }, directTools: true },
+      other: { command: 'npx', args: ['a', 'b'], env: { K: 'V', J: 'W' }, directTools: true }
+    }
+  })
+})
+
+test('toNativeMcpConfigFile maps ACP stdio servers to direct-exposure built-in entries', () => {
+  const config = toNativeMcpConfigFile([
+    stdioServer(),
+    stdioServer({
+      name: 'other',
+      command: 'npx',
+      args: ['a', 'b'],
+      env: [
+        { name: 'K', value: 'V' },
+        { name: 'J', value: 'W' }
+      ]
+    })
+  ])
+
+  assert.deepEqual(config, {
+    mcpServers: {
+      ptah: { command: '/usr/bin/ptah', args: ['__bridge'], env: { PTAH_BRIDGE_ADDR: '/tmp/sock' }, exposure: 'direct' },
+      other: { command: 'npx', args: ['a', 'b'], env: { K: 'V', J: 'W' }, exposure: 'direct' }
+    }
+  })
+})
+
+test('config writers copy args arrays defensively', () => {
+  const server = stdioServer()
+  const adapter = toAdapterMcpConfigFile([server])
+  const native = toNativeMcpConfigFile([server])
+  ;(server as any).args.push('mutated')
+  assert.deepEqual(adapter.mcpServers.ptah.args, ['__bridge'])
+  assert.deepEqual(native.mcpServers.ptah.args, ['__bridge'])
+})
+
+test('filterStdioMcpServers keeps stdio and names dropped http/sse servers', () => {
+  const { stdio, droppedNonStdio } = filterStdioMcpServers([
+    stdioServer(),
+    httpServer(),
+    { type: 'sse', name: 'legacy', url: 'https://mcp.example.com/sse', headers: [] } as McpServer
+  ])
+
+  assert.equal(stdio.length, 1)
+  assert.equal(stdio[0].name, 'ptah')
+  assert.deepEqual(droppedNonStdio, ['remote', 'legacy'])
+})
+
+test('filterStdioMcpServers treats a defensive explicit type:"stdio" as stdio', () => {
+  const { stdio, droppedNonStdio } = filterStdioMcpServers([
+    { ...stdioServer(), type: 'stdio' } as unknown as McpServer
+  ])
+
+  assert.equal(stdio.length, 1)
+  assert.deepEqual(droppedNonStdio, [])
+})
+
+test('writeMcpConfigFile writes 0600 JSON in a fresh temp dir; removeMcpConfigFile cleans up', () => {
+  const path = writeMcpConfigFile(toAdapterMcpConfigFile([stdioServer()]))
+
+  try {
+    assert.ok(path.includes(join(tmpdir(), 'pi-acp-mcp-')), `unexpected path: ${path}`)
+    assert.equal(mcpConfigFileMode(path), 0o600)
+    assert.deepEqual(readMcpConfigFile(path), toAdapterMcpConfigFile([stdioServer()]))
+  } finally {
+    removeMcpConfigFile(path)
+  }
+
+  assert.equal(existsSync(path), false)
+})
+
+// --- generated registration extension ---------------------------------------
+
+test('generated extension registers servers with exposure:direct from PI_ACP_MCP_CONFIG', async () => {
+  const dir = mkdtempSync(join(tmpdir(), 'pi-acp-mcp-ext-'))
+  const prev = process.env.PI_ACP_MCP_CONFIG
+  try {
+    const configPath = writeMcpConfigFile(toNativeMcpConfigFile([stdioServer()]), dir)
+    process.env.PI_ACP_MCP_CONFIG = configPath
+
+    const factory = await import(pathToFileURL(writeMcpRegisterExtension(dir)).href)
+    const calls: any[] = []
+    factory.default({ registerMcpServer: (name: string, config: unknown) => calls.push({ name, config }) })
+
+    assert.deepEqual(calls, [
+      {
+        name: 'ptah',
+        config: { command: '/usr/bin/ptah', args: ['__bridge'], env: { PTAH_BRIDGE_ADDR: '/tmp/sock' }, exposure: 'direct' }
+      }
+    ])
+  } finally {
+    if (prev === undefined) delete process.env.PI_ACP_MCP_CONFIG
+    else process.env.PI_ACP_MCP_CONFIG = prev
+    rmSync(dir, { recursive: true, force: true })
+  }
+})
+
+test('generated extension is a no-op without PI_ACP_MCP_CONFIG', async () => {
+  const dir = mkdtempSync(join(tmpdir(), 'pi-acp-mcp-ext-'))
+  const prev = process.env.PI_ACP_MCP_CONFIG
+  delete process.env.PI_ACP_MCP_CONFIG
+  try {
+    const factory = await import(pathToFileURL(writeMcpRegisterExtension(dir)).href)
+    const calls: string[] = []
+    factory.default({ registerMcpServer: (name: string) => calls.push(name) })
+    assert.deepEqual(calls, [])
+  } finally {
+    if (prev !== undefined) process.env.PI_ACP_MCP_CONFIG = prev
+    rmSync(dir, { recursive: true, force: true })
+  }
+})
+
+test('generated extension is a no-op when pi lacks registerMcpServer', async () => {
+  const dir = mkdtempSync(join(tmpdir(), 'pi-acp-mcp-ext-'))
+  const configPath = writeMcpConfigFile(toNativeMcpConfigFile([stdioServer()]), dir)
+  const prev = process.env.PI_ACP_MCP_CONFIG
+  process.env.PI_ACP_MCP_CONFIG = configPath
+  try {
+    const factory = await import(pathToFileURL(writeMcpRegisterExtension(dir)).href)
+    // Must not throw for an older pi.
+    factory.default({})
+  } finally {
+    if (prev === undefined) delete process.env.PI_ACP_MCP_CONFIG
+    else process.env.PI_ACP_MCP_CONFIG = prev
+    rmSync(dir, { recursive: true, force: true })
+  }
+})
+
+// --- capability probe -------------------------------------------------------
+
+test('detectMcpSupport: adapter when --mcp-config is present, cached per process', async () => {
+  await withFakePi('adapter', async rec => {
+    assert.equal(detectMcpSupport(process.env.PI_ACP_PI_COMMAND), 'adapter')
+    assert.equal(detectMcpSupport(process.env.PI_ACP_PI_COMMAND), 'adapter')
+    // Second call is served from the cache: only one --help invocation recorded.
+    assert.deepEqual(rec.lines().filter(argv => argv.includes('--help')).length, 1)
+  })
+})
+
+test('detectMcpSupport: native when the pi mcp subcommand is present', async () => {
+  await withFakePi('native', async () => {
+    assert.equal(detectMcpSupport(process.env.PI_ACP_PI_COMMAND), 'native')
+  })
+})
+
+test('detectMcpSupport: none when neither mechanism is advertised', async () => {
+  await withFakePi('none', async () => {
+    assert.equal(detectMcpSupport(process.env.PI_ACP_PI_COMMAND), 'none')
+  })
+})
+
+test('detectMcpSupport is none when pi is missing', () => {
+  resetMcpConfigSupportCacheForTests()
+  try {
+    assert.equal(detectMcpSupport('pi-does-not-exist-12345'), 'none')
+  } finally {
+    resetMcpConfigSupportCacheForTests()
+  }
+})
+
+// --- session-level preparation ----------------------------------------------
+
+test('prepareSessionMcpConfig: no servers means no probe and no delivery', async () => {
+  await withFakePi('adapter', async rec => {
+    const prepared = prepareSessionMcpConfig([], { piCommand: process.env.PI_ACP_PI_COMMAND })
+    assert.equal(prepared.delivery, null)
+    assert.deepEqual(prepared.warnings, [])
+    assert.deepEqual(rec.lines(), [])
+  })
+})
+
+test('prepareSessionMcpConfig: adapter delivery writes a 0600 adapter config; http/sse warned and dropped', async () => {
+  await withFakePi('adapter', async () => {
+    const prepared = prepareSessionMcpConfig([stdioServer(), httpServer()], {
+      piCommand: process.env.PI_ACP_PI_COMMAND
+    })
+
+    assert.ok(prepared.delivery, 'expected a delivery')
+    assert.equal(prepared.delivery!.kind, 'adapter')
+    const configPath = prepared.delivery!.configPath
+    try {
+      assert.equal(mcpConfigFileMode(configPath), 0o600)
+      assert.deepEqual(readMcpConfigFile(configPath), toAdapterMcpConfigFile([stdioServer()]))
+    } finally {
+      removeMcpConfigFile(configPath)
+    }
+
+    assert.equal(prepared.warnings.length, 1)
+    assert.match(prepared.warnings[0], /dropped 1 non-stdio MCP server/)
+    assert.match(prepared.warnings[0], /remote/)
+  })
+})
+
+test('prepareSessionMcpConfig: native delivery writes the config and registration extension in one temp dir', async () => {
+  await withFakePi('native', async () => {
+    const prepared = prepareSessionMcpConfig([stdioServer()], { piCommand: process.env.PI_ACP_PI_COMMAND })
+
+    assert.ok(prepared.delivery, 'expected a delivery')
+    assert.equal(prepared.delivery!.kind, 'native')
+    const { configPath, extensionPath } = prepared.delivery as { configPath: string; extensionPath: string }
+    try {
+      assert.equal(mcpConfigFileMode(configPath), 0o600)
+      assert.deepEqual(readMcpConfigFile(configPath), toNativeMcpConfigFile([stdioServer()]))
+      assert.ok(existsSync(extensionPath), 'registration extension missing')
+      assert.equal(dirname(configPath), dirname(extensionPath), 'config and extension must share the temp dir')
+    } finally {
+      removeMcpConfigFile(configPath)
+    }
+
+    assert.deepEqual(prepared.warnings, [])
+  })
+})
+
+test('prepareSessionMcpConfig: without any MCP support servers are warned and dropped, no files', async () => {
+  await withFakePi('none', async () => {
+    const prepared = prepareSessionMcpConfig([stdioServer()], { piCommand: process.env.PI_ACP_PI_COMMAND })
+
+    assert.equal(prepared.delivery, null)
+    assert.equal(prepared.warnings.length, 1)
+    assert.match(prepared.warnings[0], /dropped 1 MCP server/)
+    assert.match(prepared.warnings[0], /ptah/)
+    assert.match(prepared.warnings[0], /pi >= 0.99/)
+    assert.match(prepared.warnings[0], /pi install npm:pi-mcp-adapter/)
+  })
+})
