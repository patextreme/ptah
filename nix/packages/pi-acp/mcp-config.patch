@@ -0,0 +1,208 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import type { McpServer } from '@agentclientprotocol/sdk'
+import { PiAcpAgent } from '../../src/acp/agent.js'
+import { PiRpcProcess } from '../../src/pi-rpc/process.js'
+import { readMcpConfigFile, removeMcpConfigFile, resetMcpConfigSupportCacheForTests } from '../../src/acp/mcp-config.js'
+import { FakeAgentSideConnection, asAgentConn } from '../helpers/fakes.js'
+
+const FAKE_PI = fileURLToPath(new URL('../helpers/fake-pi.mjs', import.meta.url))
+
+function stdioServer(): McpServer {
+  // No `type` field: the TS SDK strips it for the untagged stdio variant.
+  return {
+    name: 'ptah',
+    command: '/usr/bin/ptah',
+    args: ['__bridge'],
+    env: [
+      { name: 'PTAH_BRIDGE_ADDR', value: '/tmp/sock' },
+      { name: 'PTAH_RESULT_SCHEMA', value: '{}' }
+    ]
+  } as McpServer
+}
+
+/** Point PI_ACP_PI_COMMAND at the fake pi and record every invocation's argv. */
+function useFakePi(helpHasMcpConfig: boolean): { argsFile: string; argvLines(): string[][]; restore(): void } {
+  const dir = mkdtempSync(join(tmpdir(), 'pi-acp-mcp-component-'))
+  const argsFile = join(dir, 'args.jsonl')
+  writeFileSync(argsFile, '', 'utf-8')
+
+  const prev = { ...process.env }
+  process.env.PI_ACP_PI_COMMAND = FAKE_PI
+  process.env.FAKE_PI_ARGS_FILE = argsFile
+  if (helpHasMcpConfig) delete process.env.FAKE_PI_HELP_HAS_MCP_CONFIG
+  else process.env.FAKE_PI_HELP_HAS_MCP_CONFIG = '0'
+  resetMcpConfigSupportCacheForTests()
+
+  return {
+    argsFile,
+    argvLines(): string[][] {
+      if (!existsSync(argsFile)) return []
+      return readFileSync(argsFile, 'utf-8')
+        .split('\n')
+        .filter(Boolean)
+        .map(l => JSON.parse(l) as string[])
+    },
+    restore() {
+      for (const key of Object.keys(process.env)) {
+        if (!(key in prev)) delete process.env[key]
+      }
+      Object.assign(process.env, prev)
+      resetMcpConfigSupportCacheForTests()
+      rmSync(dir, { recursive: true, force: true })
+    }
+  }
+}
+
+test('newSession wires stdio MCP servers via --mcp-config and cleans up on dispose', async () => {
+  const fake = useFakePi(true)
+  const conn = new FakeAgentSideConnection()
+  const agent = new PiAcpAgent(asAgentConn(conn), {} as any)
+  const cwd = mkdtempSync(join(tmpdir(), 'pi-acp-mcp-cwd-'))
+
+  let response: any
+  try {
+    response = await agent.newSession({ cwd, mcpServers: [stdioServer()] } as any)
+  } finally {
+    //
+  }
+
+  // The pi spawn argv must carry the --mcp-config <path> token pair.
+  const rpcArgv = fake.argvLines().find(argv => argv.includes('--mode') && argv.includes('rpc'))
+  assert.ok(rpcArgv, 'fake pi was not spawned in rpc mode')
+
+  const idx = rpcArgv.indexOf('--mcp-config')
+  assert.ok(idx >= 0, `--mcp-config missing from spawn argv: ${JSON.stringify(rpcArgv)}`)
+  const configPath = rpcArgv[idx + 1]
+  assert.ok(typeof configPath === 'string' && configPath.length > 0, '--mcp-config has no path argument')
+  assert.ok(existsSync(configPath), 'config file missing at spawn time')
+
+  // File contents: ACP entry mapped to a direct-tool pi-mcp-adapter entry.
+  assert.deepEqual(readMcpConfigFile(configPath), {
+    mcpServers: {
+      ptah: {
+        command: '/usr/bin/ptah',
+        args: ['__bridge'],
+        env: { PTAH_BRIDGE_ADDR: '/tmp/sock', PTAH_RESULT_SCHEMA: '{}' },
+        directTools: true
+      }
+    }
+  })
+
+  // Session end: the temp config file (and its directory) is removed.
+  // (First drain newSession's deferred timers so no post-dispose writes happen.)
+  await new Promise(resolve => setTimeout(resolve, 25))
+  agent.dispose()
+  assert.equal(existsSync(configPath), false, 'config file survived session dispose')
+
+  assert.ok(response?.sessionId, 'session/new did not return a sessionId')
+  assert.equal(
+    fake.argvLines().some(argv => argv.includes('--help')),
+    true,
+    'probe did not run'
+  )
+
+  fake.restore()
+  rmSync(cwd, { recursive: true, force: true })
+})
+
+test('newSession without --mcp-config support still spawns, warns, and passes no flag', async () => {
+  const fake = useFakePi(false)
+  const conn = new FakeAgentSideConnection()
+  const agent = new PiAcpAgent(asAgentConn(conn), {} as any)
+  const cwd = mkdtempSync(join(tmpdir(), 'pi-acp-mcp-cwd-'))
+
+  try {
+    const response = await agent.newSession({ cwd, mcpServers: [stdioServer()] } as any)
+    assert.ok(response?.sessionId, 'session/new should succeed despite dropped MCP servers')
+
+    const startupInfo = response?._meta?.piAcp?.startupInfo ?? ''
+    assert.match(startupInfo, /dropped 1 MCP server/)
+    assert.match(startupInfo, /ptah/)
+    assert.match(startupInfo, /pi install npm:pi-mcp-adapter/)
+
+    const rpcArgv = fake.argvLines().find(argv => argv.includes('--mode') && argv.includes('rpc'))
+    assert.ok(rpcArgv, 'fake pi was not spawned in rpc mode')
+    assert.equal(rpcArgv.includes('--mcp-config'), false, '--mcp-config passed to a pi without support')
+
+    await new Promise(resolve => setTimeout(resolve, 25))
+    agent.dispose()
+  } finally {
+    fake.restore()
+    rmSync(cwd, { recursive: true, force: true })
+  }
+})
+
+test('newSession without MCP servers passes no --mcp-config and stays quiet', async () => {
+  const fake = useFakePi(true)
+  const conn = new FakeAgentSideConnection()
+  const agent = new PiAcpAgent(asAgentConn(conn), {} as any)
+  const cwd = mkdtempSync(join(tmpdir(), 'pi-acp-mcp-cwd-'))
+
+  try {
+    const response = await agent.newSession({ cwd, mcpServers: [] } as any)
+    assert.ok(response?.sessionId)
+
+    const rpcArgv = fake.argvLines().find(argv => argv.includes('--mode') && argv.includes('rpc'))
+    assert.ok(rpcArgv)
+    assert.equal(rpcArgv.includes('--mcp-config'), false, '--mcp-config passed without servers')
+
+    await new Promise(resolve => setTimeout(resolve, 25))
+    agent.dispose()
+  } finally {
+    fake.restore()
+    rmSync(cwd, { recursive: true, force: true })
+  }
+})
+
+test('restoreSession (session/load path) threads mcpServers into spawn', async () => {
+  // spawn stubbed: we only assert the params threading, not a live process.
+  const fake = useFakePi(true)
+  const spawnCalls: any[] = []
+  const originalSpawn = PiRpcProcess.spawn
+  ;(PiRpcProcess as any).spawn = async (params: any) => {
+    spawnCalls.push(params)
+    return { onEvent: () => () => {}, dispose: () => {} } as any
+  }
+
+  const conn = new FakeAgentSideConnection()
+  const agent = new PiAcpAgent(asAgentConn(conn), {} as any)
+  ;(agent as any).store = {
+    get(sessionId: string) {
+      return sessionId.startsWith('stored-session')
+        ? { sessionId, cwd: '/tmp/store-project', sessionFile: '/tmp/store-project/session.jsonl' }
+        : null
+    },
+    upsert() {}
+  }
+
+  try {
+    await (agent as any).restoreSession('stored-session', { cwd: '/tmp/store-project', mcpServers: [stdioServer()] })
+
+    assert.equal(spawnCalls.length, 1)
+    assert.equal(spawnCalls[0].sessionPath, '/tmp/store-project/session.jsonl')
+    assert.ok(typeof spawnCalls[0].mcpConfigPath === 'string', 'mcpConfigPath not threaded to spawn')
+    assert.ok(existsSync(spawnCalls[0].mcpConfigPath), 'threaded config file does not exist')
+
+    // Unsupported pi: no config path. (Fresh session id: restoreSession
+    // short-circuits on an already-registered session.)
+    fake.restore()
+    const fakeNoFlag = useFakePi(false)
+    spawnCalls.length = 0
+    await (agent as any).restoreSession('stored-session-2', { cwd: '/tmp/store-project', mcpServers: [stdioServer()] })
+
+    assert.equal(spawnCalls.length, 1)
+    assert.equal(spawnCalls[0].mcpConfigPath, undefined, 'mcpConfigPath must be dropped without support')
+    fakeNoFlag.restore()
+  } finally {
+    PiRpcProcess.spawn = originalSpawn
+    for (const call of spawnCalls) {
+      if (typeof call?.mcpConfigPath === 'string') removeMcpConfigFile(call.mcpConfigPath)
+    }
+    fake.restore()
+  }
+})
diff --git a/test/helpers/fake-pi.mjs b/test/helpers/fake-pi.mjs
new file mode 100755
index 0000000..b83b205
--- /dev/null
+++ b/test/helpers/fake-pi.mjs
@@ -0,0 +1,86 @@
+#!/usr/bin/env node
+// Fake `pi` executable for tests: records its argv, answers `--help`, and
+// speaks the minimal pi RPC subset pi-acp needs during session/new.
+import { appendFileSync } from 'node:fs'
+
+const argv = process.argv.slice(2)
+
+if (process.env.FAKE_PI_ARGS_FILE) {
+  try {
+    appendFileSync(process.env.FAKE_PI_ARGS_FILE, JSON.stringify(argv) + '\n')
+  } catch {
+    // ignore recording failures
+  }
+}
+
+if (argv.includes('--help')) {
+  const lines = [
+    'Usage: pi [options]',
+    '',
+    'Options:',
+    '  --mode <value>          Run mode',
+    '  --no-themes             Disable themes',
+    '  --session <value>       Session file'
+  ]
+  // FAKE_PI_HELP_HAS_MCP_CONFIG=0 simulates a pi without the pi-mcp-adapter
+  // extension (no --mcp-config flag).
+  if (process.env.FAKE_PI_HELP_HAS_MCP_CONFIG !== '0') {
+    lines.push('  --mcp-config <value>    Path to MCP config file')
+  }
+  console.log(lines.join('\n'))
+  process.exit(0)
+}
+
+// Minimal RPC mode: newline-delimited JSON requests on stdin, responses on stdout.
+process.stdin.setEncoding('utf8')
+
+let buf = ''
+
+function respond(msg, data) {
+  process.stdout.write(JSON.stringify({ type: 'response', id: msg.id, command: msg.type, success: true, data }) + '\n')
+}
+
+function handle(line) {
+  if (!line.trim()) return
+  let msg
+  try {
+    msg = JSON.parse(line)
+  } catch {
+    return
+  }
+
+  switch (msg.type) {
+    case 'get_state':
+      respond(msg, {
+        sessionId: 'fake-pi-session',
+        sessionFile: null,
+        thinkingLevel: 'medium',
+        model: { provider: 'test', id: 'model' }
+      })
+      break
+    case 'get_available_models':
+      respond(msg, { models: [{ provider: 'test', id: 'model', name: 'model' }] })
+      break
+    case 'get_available_thinking_levels':
+      respond(msg, { levels: ['off', 'minimal', 'low', 'medium', 'high', 'xhigh'] })
+      break
+    case 'get_commands':
+      respond(msg, { commands: [] })
+      break
+    default:
+      respond(msg, {})
+      break
+  }
+}
+
+process.stdin.on('data', d => {
+  buf += d
+  let i
+  while ((i = buf.indexOf('\n')) >= 0) {
+    const line = buf.slice(0, i)
+    buf = buf.slice(i + 1)
+    handle(line)
+  }
+})
+
+process.stdin.on('end', () => process.exit(0))
diff --git a/test/unit/mcp-config.test.ts b/test/unit/mcp-config.test.ts
new file mode 100644
index 0000000..20b76b6
--- /dev/null
+++ b/test/unit/mcp-config.test.ts
@@ -0,0 +1,204 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import type { McpServer, McpServerStdio } from '@agentclientprotocol/sdk'
+import {
+  filterStdioMcpServers,
+  toMcpConfigFile,
+  writeMcpConfigFile,
+  removeMcpConfigFile,
+  readMcpConfigFile,
+  mcpConfigFileMode,
+  prepareSessionMcpConfig,
+  piSupportsMcpConfig,
+  resetMcpConfigSupportCacheForTests
+} from '../../src/acp/mcp-config.js'
+
+const FAKE_PI = fileURLToPath(new URL('../helpers/fake-pi.mjs', import.meta.url))
+
+function stdioServer(overrides: Partial<McpServerStdio> = {}): McpServerStdio {
+  // Note: no `type` field — the TS SDK strips it for the untagged stdio variant.
+  return {
+    name: 'ptah',
+    command: '/usr/bin/ptah',
+    args: ['__bridge'],
+    env: [{ name: 'PTAH_BRIDGE_ADDR', value: '/tmp/sock' }],
+    ...overrides
+  }
+}
+
+function httpServer(): McpServer {
+  return { type: 'http', name: 'remote', url: 'https://mcp.example.com', headers: [] } as McpServer
+}
+
+/** Set up a fake pi invocation recorder: returns { argsFile, lines() }. */
+function recorder(): { argsFile: string; lines(): string[][] } {
+  const dir = mkdtempSync(join(tmpdir(), 'pi-acp-mcp-test-'))
+  const argsFile = join(dir, 'args.jsonl')
+  writeFileSync(argsFile, '', 'utf-8')
+  return {
+    argsFile,
+    lines(): string[][] {
+      if (!existsSync(argsFile)) return []
+      return readFileSync(argsFile, 'utf-8')
+        .split('\n')
+        .filter(Boolean)
+        .map(l => JSON.parse(l) as string[])
+    }
+  }
+}
+
+function withFakePi(
+  helpHasMcpConfig: boolean,
+  fn: (rec: { argsFile: string; lines(): string[][] }) => Promise<void> | void
+): Promise<void> {
+  const rec = recorder()
+  const prev = { ...process.env }
+  process.env.PI_ACP_PI_COMMAND = FAKE_PI
+  process.env.FAKE_PI_ARGS_FILE = rec.argsFile
+  if (helpHasMcpConfig) delete process.env.FAKE_PI_HELP_HAS_MCP_CONFIG
+  else process.env.FAKE_PI_HELP_HAS_MCP_CONFIG = '0'
+  resetMcpConfigSupportCacheForTests()
+
+  return Promise.resolve()
+    .then(() => fn(rec))
+    .finally(() => {
+      for (const key of Object.keys(process.env)) {
+        if (!(key in prev)) delete process.env[key]
+      }
+      Object.assign(process.env, prev)
+      resetMcpConfigSupportCacheForTests()
+      rmSync(join(rec.argsFile, '..'), { recursive: true, force: true })
+    })
+}
+
+test('toMcpConfigFile maps ACP stdio servers to direct-tool pi-mcp-adapter entries', () => {
+  const config = toMcpConfigFile([
+    stdioServer(),
+    stdioServer({
+      name: 'other',
+      command: 'npx',
+      args: ['a', 'b'],
+      env: [
+        { name: 'K', value: 'V' },
+        { name: 'J', value: 'W' }
+      ]
+    })
+  ])
+
+  assert.deepEqual(config, {
+    mcpServers: {
+      ptah: { command: '/usr/bin/ptah', args: ['__bridge'], env: { PTAH_BRIDGE_ADDR: '/tmp/sock' }, directTools: true },
+      other: { command: 'npx', args: ['a', 'b'], env: { K: 'V', J: 'W' }, directTools: true }
+    }
+  })
+})
+
+test('toMcpConfigFile copies args arrays defensively', () => {
+  const server = stdioServer()
+  const config = toMcpConfigFile([server])
+  ;(server as any).args.push('mutated')
+  assert.deepEqual(config.mcpServers.ptah.args, ['__bridge'])
+})
+
+test('filterStdioMcpServers keeps stdio and names dropped http/sse servers', () => {
+  const { stdio, droppedNonStdio } = filterStdioMcpServers([
+    stdioServer(),
+    httpServer(),
+    { type: 'sse', name: 'legacy', url: 'https://mcp.example.com/sse', headers: [] } as McpServer
+  ])
+
+  assert.equal(stdio.length, 1)
+  assert.equal(stdio[0].name, 'ptah')
+  assert.deepEqual(droppedNonStdio, ['remote', 'legacy'])
+})
+
+test('filterStdioMcpServers treats a defensive explicit type:"stdio" as stdio', () => {
+  const { stdio, droppedNonStdio } = filterStdioMcpServers([
+    { ...stdioServer(), type: 'stdio' } as unknown as McpServer
+  ])
+
+  assert.equal(stdio.length, 1)
+  assert.deepEqual(droppedNonStdio, [])
+})
+
+test('writeMcpConfigFile writes 0600 JSON in a fresh temp dir; removeMcpConfigFile cleans up', () => {
+  const path = writeMcpConfigFile(toMcpConfigFile([stdioServer()]))
+
+  try {
+    assert.ok(path.includes(join(tmpdir(), 'pi-acp-mcp-')), `unexpected path: ${path}`)
+    assert.equal(mcpConfigFileMode(path), 0o600)
+    assert.deepEqual(readMcpConfigFile(path), toMcpConfigFile([stdioServer()]))
+  } finally {
+    removeMcpConfigFile(path)
+  }
+
+  assert.equal(existsSync(path), false)
+})
+
+test('piSupportsMcpConfig probes --help and caches per process', async () => {
+  await withFakePi(true, async rec => {
+    assert.equal(piSupportsMcpConfig(process.env.PI_ACP_PI_COMMAND), true)
+    assert.equal(piSupportsMcpConfig(process.env.PI_ACP_PI_COMMAND), true)
+    // Second call is served from the cache: only one --help invocation recorded.
+    assert.deepEqual(rec.lines().filter(argv => argv.includes('--help')).length, 1)
+  })
+
+  await withFakePi(false, async () => {
+    assert.equal(piSupportsMcpConfig(process.env.PI_ACP_PI_COMMAND), false)
+  })
+})
+
+test('piSupportsMcpConfig is false when pi is missing', () => {
+  resetMcpConfigSupportCacheForTests()
+  try {
+    assert.equal(piSupportsMcpConfig('pi-does-not-exist-12345'), false)
+  } finally {
+    resetMcpConfigSupportCacheForTests()
+  }
+})
+
+test('prepareSessionMcpConfig: no servers means no probe and no file', async () => {
+  await withFakePi(true, async rec => {
+    const prepared = prepareSessionMcpConfig([], { piCommand: process.env.PI_ACP_PI_COMMAND })
+    assert.equal(prepared.configPath, null)
+    assert.deepEqual(prepared.warnings, [])
+    assert.deepEqual(rec.lines(), [])
+  })
+})
+
+test('prepareSessionMcpConfig: stdio servers with support write a 0600 config; http/sse warned and dropped', async () => {
+  await withFakePi(true, async () => {
+    const prepared = prepareSessionMcpConfig([stdioServer(), httpServer()], {
+      piCommand: process.env.PI_ACP_PI_COMMAND
+    })
+
+    assert.ok(prepared.configPath, 'expected a config file')
+    try {
+      assert.equal(mcpConfigFileMode(prepared.configPath!), 0o600)
+      assert.deepEqual(readMcpConfigFile(prepared.configPath!), toMcpConfigFile([stdioServer()]))
+    } finally {
+      if (prepared.configPath) removeMcpConfigFile(prepared.configPath)
+    }
+
+    assert.equal(prepared.warnings.length, 1)
+    assert.match(prepared.warnings[0], /dropped 1 non-stdio MCP server/)
+    assert.match(prepared.warnings[0], /remote/)
+  })
+})
+
+test('prepareSessionMcpConfig: without --mcp-config support servers are warned and dropped, no file', async () => {
+  await withFakePi(false, async () => {
+    const prepared = prepareSessionMcpConfig([stdioServer()], { piCommand: process.env.PI_ACP_PI_COMMAND })
+
+    assert.equal(prepared.configPath, null)
+    assert.equal(prepared.warnings.length, 1)
+    assert.match(prepared.warnings[0], /dropped 1 MCP server/)
+    assert.match(prepared.warnings[0], /ptah/)
+    assert.match(prepared.warnings[0], /--mcp-config/)
+    assert.match(prepared.warnings[0], /pi install npm:pi-mcp-adapter/)
+  })
+})
