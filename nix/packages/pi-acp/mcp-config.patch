+test('restoreSession (session/load path) threads the MCP delivery into spawn', async () => {
+  // spawn stubbed: we only assert the params threading, not a live process.
+  const fake = useFakePi('native')
+  const spawnCalls: any[] = []
+  const originalSpawn = PiRpcProcess.spawn
+  ;(PiRpcProcess as any).spawn = async (params: any) => {
+    spawnCalls.push(params)
+    return { onEvent: () => () => {}, dispose: () => {} } as any
+  }
+
+  const conn = new FakeAgentSideConnection()
+  const agent = new PiAcpAgent(asAgentConn(conn), {} as any)
+  ;(agent as any).store = {
+    get(sessionId: string) {
+      return sessionId.startsWith('stored-session')
+        ? { sessionId, cwd: '/tmp/store-project', sessionFile: '/tmp/store-project/session.jsonl' }
+        : null
+    },
+    upsert() {}
+  }
+
+  try {
+    await (agent as any).restoreSession('stored-session', { cwd: '/tmp/store-project', mcpServers: [stdioServer()] })
+
+    assert.equal(spawnCalls.length, 1)
+    assert.equal(spawnCalls[0].sessionPath, '/tmp/store-project/session.jsonl')
+    assert.equal(spawnCalls[0].mcp?.kind, 'native', 'native delivery not threaded to spawn')
+    assert.ok(existsSync(spawnCalls[0].mcp.configPath), 'threaded config file does not exist')
+    assert.ok(existsSync(spawnCalls[0].mcp.extensionPath), 'threaded extension file does not exist')
+
+    // Adapter pi: the adapter delivery is threaded instead. (Fresh session id:
+    // restoreSession short-circuits on an already-registered session.)
+    fake.restore()
+    const fakeAdapter = useFakePi('adapter')
+    spawnCalls.length = 0
+    await (agent as any).restoreSession('stored-session-2', { cwd: '/tmp/store-project', mcpServers: [stdioServer()] })
+
+    assert.equal(spawnCalls.length, 1)
+    assert.equal(spawnCalls[0].mcp?.kind, 'adapter', 'adapter delivery not threaded to spawn')
+    assert.ok(existsSync(spawnCalls[0].mcp.configPath), 'threaded adapter config does not exist')
+
+    // Unsupported pi: no delivery.
+    fakeAdapter.restore()
+    const fakeNone = useFakePi('none')
+    spawnCalls.length = 0
+    await (agent as any).restoreSession('stored-session-3', { cwd: '/tmp/store-project', mcpServers: [stdioServer()] })
+
+    assert.equal(spawnCalls.length, 1)
+    assert.equal(spawnCalls[0].mcp, undefined, 'delivery must be dropped without support')
+    fakeNone.restore()
+  } finally {
+    PiRpcProcess.spawn = originalSpawn
+    for (const call of spawnCalls) {
+      if (typeof call?.mcp?.configPath === 'string') removeMcpConfigFile(call.mcp.configPath)
+    }
+    fake.restore()
+  }
+})
