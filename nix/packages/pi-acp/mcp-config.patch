diff --git a/src/acp/mcp-config.ts b/src/acp/mcp-config.ts
new file mode 100644
index 0000000..119dd3d
--- /dev/null
+++ b/src/acp/mcp-config.ts
@@ -0,0 +1,291 @@
+import { spawnSync } from 'node:child_process'
+import { mkdtempSync, readFileSync, rmSync, statSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import type { McpServer, McpServerStdio } from '@agentclientprotocol/sdk'
+import { getPiCommand } from '../pi-rpc/command.js'
+
+/**
+ * Wiring for ACP-provided MCP servers.
+ *
+ * ACP clients (Zed, ptah, ...) may pass `mcpServers` in `session/new` /
+ * `session/load`. pi consumes them in one of two ways, selected by a cached
+ * `pi --help` probe (acp/mcp-config.ts:detectMcpSupport):
+ *
+ * - **native** (pi >= 0.99 built-in MCP): pi-acp writes the stdio servers to a
+ *   per-session config file and generates a tiny extension that registers them
+ *   with `pi.registerMcpServer`. The extension is loaded with `-e <file>` and
+ *   finds the config through `PI_ACP_MCP_CONFIG`.
+ * - **adapter** (pi-mcp-adapter installed): the extension's `--mcp-config
+ *   <path>` flag loads the same per-session file. Preferred when present,
+ *   because an installed adapter replaces pi's built-in MCP.
+ *
+ * Either way the config lives in its own mkdtemp() directory (mode 0600 — it
+ * can carry capability tokens such as socket paths) and is removed when the pi
+ * process is disposed.
+ *
+ * Graceful degradation: when the target pi supports neither mechanism, or a
+ * server uses a non-stdio transport, the servers are warned about and dropped —
+ * never a spawn failure. (A throwing `-e` extension would abort pi, so support
+ * must be probed before the flag is passed.)
+ */
+
+/** How this session's stdio MCP servers reach pi. */
+export type McpDelivery =
+  | { kind: 'adapter'; configPath: string }
+  | { kind: 'native'; configPath: string; extensionPath: string }
+
+export type PreparedMcpConfig = {
+  /** Delivery for `PiRpcProcess.spawn`, or null when nothing is delivered. */
+  delivery: McpDelivery | null
+  /** Human-readable warnings for dropped servers, surfaced via startup notices. */
+  warnings: string[]
+}
+
+/** One `mcpServers` entry: adapter (`directTools`) or native (`exposure`). */
+export type PiMcpServerEntry = {
+  command: string
+  args: string[]
+  env: Record<string, string>
+  directTools?: true
+  exposure?: 'direct'
+}
+
+export type PiMcpConfigFile = {
+  mcpServers: Record<string, PiMcpServerEntry>
+}
+
+/**
+ * ACP stdio servers are the union's untagged variant: the TS SDK strips any
+ * `type` field for them, while http/sse/acp carry `type`. Treat "missing
+ * type" (and a defensive literal `stdio`) as stdio.
+ */
+function isStdioServer(server: McpServer): server is McpServerStdio {
+  const type = (server as { type?: unknown }).type
+  return type === undefined || type === null || type === 'stdio'
+}
+
+/** Split ACP servers into stdio servers (usable) and names of dropped non-stdio ones. */
+export function filterStdioMcpServers(servers: McpServer[]): { stdio: McpServerStdio[]; droppedNonStdio: string[] } {
+  const stdio: McpServerStdio[] = []
+  const droppedNonStdio: string[] = []
+
+  for (const server of servers) {
+    if (isStdioServer(server)) stdio.push(server)
+    else droppedNonStdio.push(server.name)
+  }
+
+  return { stdio, droppedNonStdio }
+}
+
+function toEnvRecord(server: McpServerStdio): Record<string, string> {
+  const env: Record<string, string> = {}
+  for (const v of server.env ?? []) env[v.name] = v.value
+  return env
+}
+
+/**
+ * Map ACP stdio servers to pi-mcp-adapter entries. Tools are registered as
+ * direct first-class pi tools (`directTools: true`): an ACP client offering a
+ * server is explicitly telling the agent it matters, so hiding it behind the
+ * adapter's `mcp` proxy search would invert that intent.
+ */
+export function toAdapterMcpConfigFile(stdio: McpServerStdio[]): PiMcpConfigFile {
+  const mcpServers: Record<string, PiMcpServerEntry> = {}
+
+  for (const server of stdio) {
+    mcpServers[server.name] = {
+      command: server.command,
+      args: [...(server.args ?? [])],
+      env: toEnvRecord(server),
+      directTools: true
+    }
+  }
+
+  return { mcpServers }
+}
+
+/**
+ * Map ACP stdio servers to pi's built-in `mcp.json` entries with
+ * `exposure: 'direct'` — the native equivalent of the adapter's
+ * `directTools: true`, so the server's tools are declared to the model.
+ */
+export function toNativeMcpConfigFile(stdio: McpServerStdio[]): PiMcpConfigFile {
+  const mcpServers: Record<string, PiMcpServerEntry> = {}
+
+  for (const server of stdio) {
+    mcpServers[server.name] = {
+      command: server.command,
+      args: [...(server.args ?? [])],
+      env: toEnvRecord(server),
+      exposure: 'direct'
+    }
+  }
+
+  return { mcpServers }
+}
+
+function createSessionTempDir(): string {
+  return mkdtempSync(join(tmpdir(), 'pi-acp-mcp-'))
+}
+
+/**
+ * Write the config into `dir` (a fresh temp dir by default) and return the file
+ * path. Mode 0600: the env block can carry capability tokens (e.g. socket paths).
+ */
+export function writeMcpConfigFile(config: PiMcpConfigFile, dir: string = createSessionTempDir()): string {
+  const file = join(dir, 'mcp.json')
+  writeFileSync(file, JSON.stringify(config, null, 2) + '\n', { mode: 0o600 })
+  return file
+}
+
+/** Best-effort removal of a config file and its temp directory. */
+export function removeMcpConfigFile(path: string): void {
+  try {
+    rmSync(dirname(path), { recursive: true, force: true })
+  } catch {
+    // stale files are inert; tmpdir cleanup eventually reclaims them
+  }
+}
+
+/** Read back a written config file (used by tests and diagnostics). */
+export function readMcpConfigFile(path: string): PiMcpConfigFile {
+  return JSON.parse(readFileSync(path, 'utf-8')) as PiMcpConfigFile
+}
+
+// --- native registration extension ------------------------------------------
+
+export const MCP_REGISTER_EXTENSION_FILENAME = 'register-mcp-extension.mjs'
+
+/**
+ * Generated per session and loaded with `-e`: registers the servers named by
+ * `PI_ACP_MCP_CONFIG` with pi's built-in MCP. Written as source text rather
+ * than a build-emitted asset so the carried patch stays self-contained and
+ * behaves identically from source (tsx) and from the bundled dist.
+ */
+export const MCP_REGISTER_EXTENSION_SOURCE = `import { readFileSync } from 'node:fs'
+
+// Generated per session by pi-acp: register ACP-provided MCP servers with
+// pi's built-in MCP support. No-op when there is nothing to register.
+export default function (pi) {
+  const path = process.env.PI_ACP_MCP_CONFIG
+  if (!path) return
+  if (typeof pi.registerMcpServer !== 'function') {
+    console.error('[pi-acp] this pi cannot register MCP servers (built-in MCP requires pi >= 0.99).')
+    return
+  }
+  let servers
+  try {
+    servers = JSON.parse(readFileSync(path, 'utf-8')).mcpServers ?? {}
+  } catch (e) {
+    console.error('[pi-acp] failed to read MCP config ' + path + ': ' + (e && e.message ? e.message : e))
+    return
+  }
+  for (const [name, config] of Object.entries(servers)) {
+    try {
+      pi.registerMcpServer(name, { ...config, exposure: 'direct' })
+    } catch (e) {
+      console.error('[pi-acp] failed to register MCP server ' + name + ': ' + (e && e.message ? e.message : e))
+    }
+  }
+}
+`
+
+/** Write the registration extension into `dir` and return its path. */
+export function writeMcpRegisterExtension(dir: string): string {
+  const file = join(dir, MCP_REGISTER_EXTENSION_FILENAME)
+  writeFileSync(file, MCP_REGISTER_EXTENSION_SOURCE, { mode: 0o600 })
+  return file
+}
+
+// --- capability probe -------------------------------------------------------
+
+export type McpSupport = 'adapter' | 'native' | 'none'
+
+/**
+ * Which mechanism the target pi understands. Probed lazily (only when stdio
+ * MCP servers are actually offered) and cached per pi-acp process: a throwing
+ * `-e` extension aborts pi, so native delivery must be confirmed first.
+ */
+let mcpSupportCache: McpSupport | null = null
+
+/** Reset the per-process probe cache (test helper). */
+export function resetMcpConfigSupportCacheForTests(): void {
+  mcpSupportCache = null
+}
+
+/**
+ * Probe the target pi's `--help`:
+ * - `--mcp-config` present → `adapter` (pi-mcp-adapter owns MCP; prefer it so
+ *   the adapter is not bypassed);
+ * - else `pi mcp` subcommand → `native` (pi >= 0.99 built-in MCP);
+ * - else → `none` (warn and drop).
+ */
+export function detectMcpSupport(piCommand?: string): McpSupport {
+  if (mcpSupportCache !== null) return mcpSupportCache
+
+  try {
+    const res = spawnSync(getPiCommand(piCommand), ['--help'], { encoding: 'utf-8', timeout: 10_000 })
+    const text = `${res.stdout ?? ''}\n${res.stderr ?? ''}`
+    if (res.status === 0 && text.includes('--mcp-config')) mcpSupportCache = 'adapter'
+    else if (res.status === 0 && /^\s*pi mcp(\s|$)/m.test(text)) mcpSupportCache = 'native'
+    else mcpSupportCache = 'none'
+  } catch {
+    mcpSupportCache = 'none'
+  }
+
+  return mcpSupportCache
+}
+
+// --- session-level preparation ----------------------------------------------
+
+/**
+ * Prepare the per-session MCP delivery from ACP-provided servers: filter to
+ * stdio, probe support, write the ephemeral file(s). Callers pass `delivery`
+ * to `PiRpcProcess.spawn` and surface `warnings` to the user; files are removed
+ * when the pi process is disposed.
+ */
+export function prepareSessionMcpConfig(
+  servers: McpServer[] | undefined | null,
+  opts: { piCommand?: string }
+): PreparedMcpConfig {
+  const all = servers ?? []
+  if (all.length === 0) return { delivery: null, warnings: [] }
+
+  const { stdio, droppedNonStdio } = filterStdioMcpServers(all)
+  const warnings: string[] = []
+
+  if (droppedNonStdio.length > 0) {
+    warnings.push(
+      `MCP: dropped ${droppedNonStdio.length} non-stdio MCP server(s) ` +
+        `(${droppedNonStdio.join(', ')}): pi only supports stdio MCP servers.`
+    )
+  }
+
+  if (stdio.length === 0) return { delivery: null, warnings }
+
+  const support = detectMcpSupport(opts.piCommand)
+
+  if (support === 'adapter') {
+    return { delivery: { kind: 'adapter', configPath: writeMcpConfigFile(toAdapterMcpConfigFile(stdio)) }, warnings }
+  }
+
+  if (support === 'native') {
+    const dir = createSessionTempDir()
+    const configPath = writeMcpConfigFile(toNativeMcpConfigFile(stdio), dir)
+    const extensionPath = writeMcpRegisterExtension(dir)
+    return { delivery: { kind: 'native', configPath, extensionPath }, warnings }
+  }
+
+  warnings.push(
+    `MCP: dropped ${stdio.length} MCP server(s) (${stdio.map(s => s.name).join(', ')}): ` +
+      `this pi has no MCP support (needs built-in MCP from pi >= 0.99, ` +
+      `or the pi MCP adapter: pi install npm:pi-mcp-adapter).`
+  )
+  return { delivery: null, warnings }
+}
+
+/** Exposed for tests: assert the config file is written with owner-only permissions. */
+export function mcpConfigFileMode(path: string): number {
+  return statSync(path).mode & 0o777
+}
