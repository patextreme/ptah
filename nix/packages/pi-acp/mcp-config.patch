+}
+
+test('newSession wires stdio MCP servers through native built-in MCP and cleans up on dispose', async () => {
+  const fake = useFakePi('native')
+  const conn = new FakeAgentSideConnection()
+  const agent = new PiAcpAgent(asAgentConn(conn), {} as any)
+  const cwd = mkdtempSync(join(tmpdir(), 'pi-acp-mcp-cwd-'))
+
+  let response: any
+  try {
+    response = await agent.newSession({ cwd, mcpServers: [stdioServer()] } as any)
+  } finally {
+    //
+  }
+
+  const argv = rpcArgv(fake)
+  const idx = argv.indexOf('-e')
+  assert.ok(idx >= 0, `-e missing from spawn argv: ${JSON.stringify(argv)}`)
+  const extensionPath = argv[idx + 1]
+  assert.ok(existsSync(extensionPath), 'registration extension missing at spawn time')
+
+  const envEntry = fake.envLines().find(e => e.argv.includes('--mode') && e.argv.includes('rpc'))
+  assert.ok(envEntry, 'no env record for the rpc spawn')
+  const configPath = envEntry!.PI_ACP_MCP_CONFIG
+  assert.ok(typeof configPath === 'string' && configPath.length > 0, 'PI_ACP_MCP_CONFIG not set on the child')
+  assert.ok(existsSync(configPath!), 'config file missing at spawn time')
+
+  // File contents: ACP entry mapped to a direct-exposure built-in MCP entry.
+  assert.deepEqual(readMcpConfigFile(configPath!), {
+    mcpServers: {
